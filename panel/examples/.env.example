# Traefik + Edge Tunnel Panel 环境变量
# 复制：cp .env.example .env

# 面板域名（需解析到本机公网 IP，Let's Encrypt HTTP-01 校验）
DOMAIN=panel.example.com

# ACME 邮箱
ACME_EMAIL=admin@example.com

# Release 版本（Dockerfile 从 GitHub Release 下载；本地已 build 可改用 image 字段）
ETP_VERSION=v0.3.1

# Controller Token（留空则安装后从容器日志/数据目录获取；生产务必设置）
EDGE_OPERATOR_TOKEN=
EDGE_CONTROLLER_TOKEN=
EDGE_STRICT_AUTH=true
